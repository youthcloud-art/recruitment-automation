# 本机运行配置示例。复制为 backend/.env 后，只在本机填写真实密钥。
# 换机恢复已有 SQLite 简历库时建议保留此配置；遗漏时系统会自动识别 SQLite，避免读取旧 JSON。
HOST=127.0.0.1
PORT=5001
NODE_ENV=development
RESUME_STORAGE_ENGINE=sqlite

# OpenAI 兼容格式的大模型接口；按实际服务商填写地址、模型和密钥。
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# 向量化配置
# 向量化模式：local(本地模型) | huggingface(API) | mock(模拟模式)
VECTORIZATION_MODE=local
# 是否强制使用本地模型（忽略API配置）
USE_LOCAL_MODEL=true
# Hugging Face API配置（用于文本向量化）
HUGGINGFACE_API_KEY=

# 可选：在网页“发件邮箱设置”里配置通用 SMTP，系统会写入本机 .env。
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASS_B64=
# SMTP_SECURE=auto
# SMTP_REQUIRE_TLS=false

CORS_ORIGIN=http://localhost:3000
